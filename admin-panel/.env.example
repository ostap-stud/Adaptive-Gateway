# Vite dev proxy. No passwords, JWT secrets or technical keys belong here.
GATEWAY_URL=http://127.0.0.1:8088
# Browser-visible Gateway origin for native Swagger UI and its Try it out requests.
# Use / when the frontend and Gateway share the same public origin in deployment.
VITE_GATEWAY_PUBLIC_URL=http://127.0.0.1:8088
# Optional API prefix for a reverse-proxy deployment. Default: /auth-service
VITE_API_BASE=/auth-service
